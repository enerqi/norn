	{0x2d120, 0, {0, 0.0121118017, 0.277329206, 0.532919228, 0.177639753, 0, 0, 0, 0, 0, 0, 0, 0, 0}, "Play low to 10 then low to Q", "Lead low from North. If East plays low, play the 10 from South; if East plays the K or J, or shows out, play low from South. If West plays the K, lead the Q from North next. If West shows out, lead low from North next. Then lead low from South. If West plays the J, 9, 8 or low, play the Q from North; if West plays the K, play the A from North; if West shows out, play low from North. If East shows out, lead low from North next. Then cash your winners. Chances vs best defence, at least: 4 tricks 18%, 3 tricks 71%, 2 tricks 99%, 1 trick 100%.", 24058, 11},
	{0x2d121, 3, {0, 0, 0.0195652172, 0.0760869533, 0.463478267, 0.44086957, 0, 0, 0, 0, 0, 0, 0, 0}, "Play low to low then 10 to Q", "Lead low from South. If West plays low or shows out, play low from North; if West plays the K, play the A from North; if West plays the J or 9, play the Q from North. If East plays the K, lead the Q from North next. Then lead the 10 from South. If West plays the J or low, play the Q from North; if West plays the K, play the A from North; if West shows out, play low from North. If East shows out, lead low from North next. Then cash your winners. Chances vs best defence, at least: 5 tricks 44%, 4 tricks 90%, 3 tricks 98%, 2 tricks 100%.", 24069, 9},
	{0x2d122, 3, {0, 0, 0.0956521705, 0.463478267, 0.406956524, 0.0339130424, 0, 0, 0, 0, 0, 0, 0, 0}, "Play low to A then low to low then low to 10", "Lead low from South. If West plays the K or low, play the A from North; if West plays the J or 9, play the Q from North; if West shows out, play low from North. If East plays the K, lead the Q from North next. If East plays the J or shows out, lead low from North next. Then lead low from South. If West plays the K or low, or shows out, play low from North; if West plays the J, play the Q from North. If East plays the K, lead the Q from North next. If East shows out, lead the 10 from South next. Then lead low from North to the 10 in South. Then cash your winners. Chances vs best defence, at least: 5 tricks 3%, 4 tricks 44%, 3 tricks 90%, 2 tricks 100%.", 24078, 10},
