	{0x29289, 0, {0, 0, 0.11304348, 0.756956518, 0.129999995, 0, 0, 0, 0, 0, 0, 0, 0, 0}, "Run the J then A then low to 9", "Lead the J from South. If West plays the 10 or low, or shows out, play low from North; if West plays the K, play the A from North. If East plays the 10, lead low from South next. If East shows out, lead low from North next. Then lead the A from North and play low from South. Then lead low from North to the 9 in South. Then cash your winners. Chances vs best defence, at least: 4 tricks 13%, 3 tricks 89%, 2 tricks 100%.", 19104, 8},
	{0x29290, 0, {0, 0, 0, 0.810248435, 0.189751551, 0, 0, 0, 0, 0, 0, 0, 0, 0}, "Play low to 10 then run the J", "Lead low from South. If West plays low or shows out, play the 10 from North; if West plays the K, play the A from North. If East plays the K or shows out, lead low from North next. Then lead the J from South. If West plays low or shows out, play low from North; if West plays the K, play the A from North. If East plays the K or shows out, lead low from North next. Then cash your winners. Chances vs best defence, at least: 4 tricks 19%, 3 tricks 100%.", 19112, 9},
	{0x29291, 0, {0, 0, 0, 0.0195652172, 0.528260887, 0.452173918, 0, 0, 0, 0, 0, 0, 0, 0}, "Run the J then run the Q", "Lead the J from South. If West plays the 9 or low, or shows out, play low from North; if West plays the K, play the A from North. If East plays the K or shows out, lead low from North next. If East plays the 9, lead low from South next. Then lead the Q from South. If West plays the 9 or low, or shows out, play low from North; if West plays the K, play the A from North. If East plays the K, lead the 10 from North next. If East shows out, lead low from South next. Then cash your winners. Chances vs best defence, at least: 5 tricks 45%, 4 tricks 98%, 3 tricks 100%.", 19121, 9},
	{0x29294, 0, {0, 0, 0, 0, 0.519565225, 0.480434775, 0, 0, 0, 0, 0, 0, 0, 0}, "Play low to 9 then run the J", "Lead low from South. If West plays low or shows out, play the 9 from North; if West plays the K, play the A from North. If East plays the K or shows out, lead low from North next. Then lead the J from South. If West plays low or shows out, play low from North; if West plays the K, play the A from North. If East plays the K, lead low from North next. If East shows out, lead the Q from South next. Then cash your winners. Chances vs best defence, at least: 5 tricks 48%, 4 tricks 100%.", 19130, 10},
