	{0x0a452, 0, {0, 0, 0, 0.111801244, 0.629813671, 0.258385092, 0, 0, 0, 0, 0, 0, 0, 0}, "Play low to A then low to 10", "Lead low from North. If East plays the Q, 9 or low, play the A from South; if East shows out, play low from South. If West plays the Q, lead the 10 from North next. If West shows out, lead low from North next. Then lead low from South. If West plays the 9 or low, play the 10 from North; if West plays the Q, play the K from North; if West shows out, play low from North. If East plays the Q, lead the J from North next. If East shows out, lead low from North next. Then cash your winners. Chances vs best defence, at least: 5 tricks 26%, 4 tricks 89%, 3 tricks 100%.", 5186, 11},
	{0x0a462, 0, {0, 0, 0, 0.705279529, 0.294720501, 0, 0, 0, 0, 0, 0, 0, 0, 0}, "Play low to A then low to J", "Lead low from North. If East plays the Q, 9 or low, play the A from South; if East shows out, play low from South. If West plays the Q or shows out, lead low from North next. Then lead low from South. If West plays the 9 or low, or shows out, play the J from North; if West plays the Q, play the K from North. If East plays the Q or shows out, lead low from North next. Then cash your winners. Chances vs best defence, at least: 4 tricks 29%, 3 tricks 100%.", 5197, 11},
	{0x0a46a, 0, {0, 0, 0, 0.471739143, 0.528260887, 0, 0, 0, 0, 0, 0, 0, 0, 0}, "Play low to A then low to low", "Lead low from North to the A in South. If West plays the Q or shows out, lead low from North next. Then lead low from South. If West plays low or shows out, play low from North; if West plays the Q, play the K from North. If East plays the Q, lead the J from North next. If East shows out, lead the 9 from South next. Then cash your winners. Chances vs best defence, at least: 4 tricks 53%, 3 tricks 100%.", 5208, 9},
