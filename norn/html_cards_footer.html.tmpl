		  }
		  if (oppBtn) oppBtn.onclick = function () {
				ccaOppOpen = !ccaOppOpen;
				syncOppUI();
				positionCca(); // height changed -> re-place
		  };
		  oppInputs.forEach(function (inp) { inp.oninput = applyOpp; });
		  if (oppClear) oppClear.onclick = function () {
