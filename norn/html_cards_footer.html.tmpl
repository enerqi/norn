		  });
		  // Contract-strain picker (shown only if some board has sample data). Default = the baked contract.
		  var strainBtns = ccaStrainWrap ? Array.prototype.slice.call(ccaStrainWrap.querySelectorAll('[data-str]')) : [];
		  function setStrain(k) {
				ccaStrain = k;
				strainBtns.forEach(function (btn) { btn.classList.toggle('sel', btn.getAttribute('data-str') === k); });
				simBand();
		  }
		  strainBtns.forEach(function (btn) { btn.onclick = function () { setStrain(btn.getAttribute('data-str')); }; });
		  var simDefault = null;
		  for (var ci = 0; ci < combos.length; ci++) { if (combos[ci]._sim) { simDefault = combos[ci]._sim; break; } }
		  if (simDefault && ccaStrainWrap) { setHidden(ccaStrainWrap, false); }
		  setStrain(simDefault && simDefault.strain ? simDefault.strain : 'nt');

		  // Help modal.
		  var helpModal = document.getElementById('nc-cca-help-modal');
		  var helpBtn = document.getElementById('nc-cca-help'), helpClose = document.getElementById('nc-cca-help-close');
		  if (helpBtn) helpBtn.onclick = function () { setHidden(helpModal, false); };
		  if (helpClose) helpClose.onclick = function () { setHidden(helpModal, true); };
		  if (helpModal) helpModal.onclick = function (e) { if (e.target === helpModal) setHidden(helpModal, true); };
		  // Hover tooltip: the detailed play narration for a suit's recommended line (delegation, since the
		  // table is rebuilt on every nav / toggle).
		  var tipEl = document.getElementById('nc-cca-tip');
		  function posTip(e) {
				if (!tipEl) return;
				var m = 14;
				tipEl.style.left = Math.min(e.clientX + m, viewW() - tipEl.offsetWidth - 8) + 'px';
				tipEl.style.top = Math.min(e.clientY + m, viewH() - tipEl.offsetHeight - 8) + 'px';
		  }
		  function tipTarget(e) { return e.target && e.target.closest ? e.target.closest('[data-tip]') : null; }
		  document.addEventListener('mouseover', function (e) {
				var t = tipTarget(e);
				if (t && tipEl) { tipEl.textContent = t.getAttribute('data-tip'); setHidden(tipEl, false); posTip(e); }
		  });
		  document.addEventListener('mousemove', function (e) { if (tipEl && !isHidden(tipEl)) posTip(e); });
		  document.addEventListener('mouseout', function (e) { if (tipTarget(e) && tipEl) setHidden(tipEl, true); });

		  if (combos.length === 0 && ccaBtn) ccaBtn.style.display = 'none';

		  // Resize arrives once per mouse move while a window edge is dragged, and `show` is not free: it
		  // re-renders the overlay table and re-places the panel. Re-centre on every event (one measurement and
		  // one transform, and no animation while the pointer is dragging) and do the rest once it stops.
		  var resizeT = null;
		  function onResized() {
				refit();
				clearTimeout(resizeT);
				resizeT = setTimeout(function () { show(idx, true); }, 120);
		  }
		  window.addEventListener('resize', onResized);

		  // AND a size WATCH, because a `window` resize event is not the only way this document changes size —
		  // hosted in the workbench's Sciter `<frame>` it is not even a way it happens. Measured in the real
		  // window: enlarging the workbench window resized the frame and relaid the document out, and NO
		  // resize event reached the page, so the board stayed where the old width had centred it and the CCA
		  // panel kept the old width's size and position until a click on CCA re-ran `show` — the page looked
		  // like it had no responsive layout at all. There is no event to subscribe to from inside the frame,
		  // so the viewport's own box is watched instead: two integer reads, and the work only happens on a
		  // CHANGE (the boards outside the layout window are parked, so a re-fit is cheap).
		  var seenW = viewport.clientWidth, seenH = viewport.clientHeight;
		  setInterval(function () {
				var w = viewport.clientWidth, h = viewport.clientHeight;
				if (w === seenW && h === seenH) { return; }
				seenW = w; seenH = h;
				onResized();
		  }, 200);
		  applyAll();
		  syncSideToggle(); // lock ccaSide to board 0's known side before the first inline-badge render
		  combos.forEach(comboLine);
		  padTrack();
		  show(0, true);   // the opening board is not a movement
		  setTimeout(refit, 0);     // a document that was laid out AFTER this script ran (the Sciter frame)
		  setTimeout(refit, 150);   // ... and one whose fonts/metrics settled a beat later
	 })();
	 </script>
</body>
